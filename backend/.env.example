# 服务端口（微信云托管默认探测 80 端口，本地开发可用 3000）
PORT=3000
HOST=0.0.0.0

# 存储模式：local（本地/云服务器ECS）| cloudbase（微信云托管云存储中转）
STORAGE_MODE=local

# 微信云托管环境 ID（当前端传入 source='cloudbase' 时使用，云托管容器会自动注入 CBR_ENV_ID / TCB_ENV）
WX_CLOUD_ENV=

# 并发控制：1核2G建议设为1，2核4G建议设为2
MAX_CONCURRENCY=2

# 最大允许上传/处理的单文件大小（字节，默认 100MB）
MAX_FILE_SIZE=104857600

# 临时文件自动清理时间（毫秒，默认 30 分钟）
FILE_TTL_MS=1800000

# 证件照抠图引擎：smart-chroma（免费内置算法）| rembg（Python自建服务）
CUTOUT_PROVIDER=smart-chroma
REMBG_ENDPOINT=http://127.0.0.1:5000/api/remove
